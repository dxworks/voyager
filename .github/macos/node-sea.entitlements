<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the macOS Node single executable, signed with the hardened runtime
  (required for notarization). V8 compiles JavaScript at run time, so it needs JIT and
  writable code memory; without them the program stops at start ("Failed to reserve
  virtual memory for CodeRange"). Same two entitlements as Node's own macOS release.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
